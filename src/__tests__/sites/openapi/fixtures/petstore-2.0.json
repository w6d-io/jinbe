{
  "swagger": "2.0",
  "info": { "title": "Swagger Petstore", "version": "1.0.0" },
  "host": "10.0.0.1",
  "basePath": "/v1",
  "schemes": ["https"],
  "securityDefinitions": { "petstore_auth": { "type": "oauth2", "flow": "implicit", "authorizationUrl": "https://x.test/auth", "scopes": { "read:pets": "read", "write:pets": "write" } } },
  "parameters": { "petId": { "name": "petId", "in": "path", "required": true, "type": "integer" } },
  "paths": {
    "/pets": {
      "get": { "operationId": "listPets", "tags": ["pets"], "security": [{ "petstore_auth": ["read:pets"] }], "responses": { "200": { "description": "ok", "schema": { "$ref": "#/definitions/Pets" } } } },
      "post": { "operationId": "createPets", "tags": ["pets"], "security": [{ "petstore_auth": ["write:pets"] }], "responses": { "201": { "description": "ok" } } }
    },
    "/pets/{petId}": {
      "parameters": [{ "$ref": "#/parameters/petId" }],
      "get": { "operationId": "showPetById", "tags": ["pets"], "responses": { "200": { "description": "ok" } } }
    }
  },
  "definitions": {
    "Pet": { "type": "object", "properties": { "id": { "type": "integer" }, "children": { "type": "array", "items": { "$ref": "#/definitions/Pet" } } } },
    "Pets": { "type": "array", "items": { "$ref": "#/definitions/Pet" } }
  }
}
